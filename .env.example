# Copy this to .env.local for local overrides (gitignored, never commit real values) - not
# actually required for local dev, since src/config.ts falls back to http://localhost:5100 and
# the real Google Client ID when these are unset.
#
# For the deployed site, these are set in Vercel's dashboard instead (Project Settings ->
# Environment Variables), never committed here.

VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
